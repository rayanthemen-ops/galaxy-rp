end

-- ═══════════════════════════════════════════════════
-- ACTION KICK — MULTI-CIBLES (OPTIMISÉ & INSTANTANÉ)
-- ═══════════════════════════════════════════════════
local function execAction(action)
    if #selectedPlayers == 0 then
        return
    end

    local reason = "Expulsé par l'admin"

    for _, target in ipairs(selectedPlayers) do
        if target and target ~= LocalPlayer and Players:FindFirstChild(target.Name) then
            local tName  = target.Name
            local tId    = target.UserId

            -- Exécution asynchrone ultra-rapide en parallèle pour chaque cible
            task.spawn(function()
                if SR.sfServer and action == "kick" and SR.sfKick then
                    pcall(function() SR.sfKick:FireServer(tName, reason) end)
                end

                if SR.chatBased then
                    for _,pfx in ipairs(SR.chatPrefixes) do
                        if action == "kick" then
                            chat(pfx.."kick "..tName.." "..reason)
                            chat(pfx.."k "..tName)
                        end
                    end
                end

                for _,r in ipairs(SR.kickR) do
                    pcall(function()
                        if r:IsA("RemoteEvent") then
                            r:FireServer(target, reason)
                            r:FireServer(tName,  reason)
                            r:FireServer(tId,    reason)
                            r:FireServer({player=target, name=tName, userId=tId, reason=reason, action=action})
                            r:FireServer(action, target, reason)
                        elseif r:IsA("RemoteFunction") then
                            r:InvokeServer(target, reason)
                        elseif r:IsA("BindableEvent") then
                            r:Fire(target, reason)
                        end
                    end)
                end

                for _,r in ipairs(SR.staffR) do
                    pcall(function()
                        if r:IsA("RemoteEvent") then
                            r:FireServer(action, target, reason)
                            r:FireServer(action, tName,  reason)
                            r:FireServer({action=action, target=target, reason=reason})
                        end
                    end)
                end

                for _,r in ipairs(SR.allR) do
                    if r:IsA("RemoteEvent") then
                        pcall(function()
                            r:FireServer(action, target, reason)
                            r:FireServer(target, action, reason)
                        end)
                    end
                end
            end)
        end
    end

    selectedPlayers = {}
    updateList()
end

